# BLACK MAMBA — environment template.
# Copy to .env (gitignored) and replace EVERY "change-me" value:
#   cp .env.example .env
# Generate secrets:          openssl rand -hex 32
# Generate a Fernet key:     python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# Generate a MinIO KMS key:  echo "blackmamba-key:$(openssl rand -base64 32)"

# ---- App
APP_ENV=development
DEBUG=false
SECRET_KEY=change-me-openssl-rand-hex-32
# Encrypts TOTP secrets and other sensitive fields. Never change it after go-live (data loss).
FIELD_ENCRYPTION_KEY=change-me-fernet-key
CORS_ORIGINS=["http://localhost:3000"]
# Used to build invitation / password-reset links.
PUBLIC_WEB_URL=http://localhost:3000

# ---- PostgreSQL (docker compose reads these too)
POSTGRES_USER=blackmamba
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=blackmamba
# Host port for the dev container (change if another PostgreSQL already uses 5432).
POSTGRES_HOST_PORT=5432
# For running the API on the host (uv run ...). Compose overrides the host to "postgres".
DATABASE_URL=postgresql+asyncpg://blackmamba:change-me-postgres@localhost:5432/blackmamba

# ---- Redis (queue + login rate limiting)
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_BACKEND=redis

# ---- Evidence storage: MinIO / S3 with server-side encryption
STORAGE_BACKEND=s3
MINIO_ROOT_USER=blackmamba
MINIO_ROOT_PASSWORD=change-me-minio-password
# Dev-only key (format "name:base64-32-bytes"). Regenerate; use a real KMS in production.
MINIO_KMS_SECRET_KEY=change-me-name:base64-32-bytes
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=blackmamba
S3_SECRET_KEY=change-me-minio-password
S3_BUCKET=evidence
MAX_UPLOAD_MB=50

# ---- Archiver
ARCHIVE_TIMEOUT_SECONDS=60
# Never true outside tests: disables SSRF protection.
ARCHIVE_ALLOW_PRIVATE_HOSTS=false

# ---- ARCHIVIST agent: anthropic (hosted) | ollama (self-hosted) | fake (offline placeholder)
LLM_PROVIDER=fake
LLM_MODEL=claude-opus-5-5
LLM_API_KEY=
# For Ollama, e.g. http://host.docker.internal:11434 with LLM_MODEL=llama3.1
LLM_BASE_URL=

# ---- Email (optional). Unset = invite/reset links are shown to admins to share securely.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=BLACK MAMBA <no-reply@example.org>

# ---- Production only (docker-compose.prod.yml, see docs/DEPLOYMENT.md)
DOMAIN=app.example.org
ACME_EMAIL=ops@example.org
