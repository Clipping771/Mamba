# BLACK MAMBA edge proxy: automatic HTTPS (Let's Encrypt via TLS-ALPN on port 443 only).
{
	email {$ACME_EMAIL}
	# Port 80 stays closed (firewall: 443 only), so use the TLS-ALPN challenge.
	auto_https disable_redirects
	servers {
		protocols h1 h2 h3
	}
}

{$DOMAIN} {
	tls {
		issuer acme {
			disable_http_challenge
		}
	}

	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		X-Frame-Options "DENY"
		Content-Security-Policy "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; frame-src 'self'; connect-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		-Server
	}

	# Uploads are limited by the API too (MAX_UPLOAD_MB); keep a slightly larger edge limit.
	request_body {
		max_size 60MB
	}

	# Liveness for external uptime monitoring.
	handle /healthz {
		respond "ok" 200
	}

	# Everything (pages and /api/bm/* BFF calls) goes to the Next.js app.
	# The FastAPI service itself is never exposed to the internet.
	reverse_proxy web:3000 {
		header_up X-Forwarded-For {remote_host}
	}

	log {
		output stdout
		format json
	}
}
